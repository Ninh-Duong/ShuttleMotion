    {
      "id": "low-serve-net-battle",
      "category": "serve-receive",
      "status": "draft-source-derived",
      "title": {
        "en": "Low serve to the centre and the net battle",
        "vi": "Giao cầu thấp vào giữa và tranh chấp lưới"
      },
      "objective": {
        "en": "See where the server, the server's partner and the receiver stand, and who covers which replies after a low serve.",
        "vi": "Thấy vị trí người giao, đồng đội người giao và người nhận, và ai lo những cú trả nào sau quả giao thấp."
      },
      "sources": [
        {
          "sourceId": "bwf-coach-manual-l1-2017",
          "pages": "148-153, 159-164"
        }
      ],
      "players": {
        "A1": {
          "team": "A",
          "role": {
            "en": "Server",
            "vi": "Người giao"
          }
        },
        "A2": {
          "team": "A",
          "role": {
            "en": "Server's partner",
            "vi": "Đồng đội người giao"
          }
        },
        "B1": {
          "team": "B",
          "role": {
            "en": "Receiver",
            "vi": "Người nhận"
          }
        },
        "B2": {
          "team": "B",
          "role": {
            "en": "Receiver's partner",
            "vi": "Đồng đội người nhận"
          }
        }
      },
      "steps": [
        {
          "positions": {
            "A1": {
              "left": -0.4,
              "fromNet": 2.6
            },
            "A2": {
              "left": 0,
              "fromNet": 4
            },
            "B1": {
              "left": -0.5,
              "fromNet": 2.4
            },
            "B2": {
              "left": 0.3,
              "fromNet": 4.4
            }
          },
          "shot": {
            "by": "A1",
            "type": "lowServe",
            "to": {
              "left": -0.2,
              "fromNet": 2.15
            },
            "arc": "flat",
            "contactHeight": 1.05
          },
          "caption": {
            "en": "The server serves from close to the T with the partner central in the midcourt; low serves usually go to the centre to cut down the angles of return.",
            "vi": "Người giao đứng gần chữ T, đồng đội đứng giữa sân; cầu giao thấp thường vào giữa để thu hẹp góc trả cầu."
          },
          "quote": {
            "text": "the server delivers from close to the 'T' on the court, with her partner stood centrally in the midcourt",
            "pages": "159-164"
          }
        },
        {
          "positions": {
            "A1": {
              "left": -0.3,
              "fromNet": 2
            },
            "A2": {
              "left": 0,
              "fromNet": 4
            },
            "B1": {
              "left": -0.3,
              "fromNet": 1
            },
            "B2": {
              "left": 0.3,
              "fromNet": 4.4
            }
          },
          "shot": {
            "by": "B1",
            "type": "net",
            "to": {
              "left": -0.5,
              "fromNet": 1.1
            },
            "arc": "flat"
          },
          "caption": {
            "en": "The receiver moves in to dominate the net with a net reply.",
            "vi": "Người nhận lao lên làm chủ lưới bằng một cú bỏ nhỏ trả lưới."
          },
          "quote": {
            "text": "should seek to dominate the net and kill any further net shots from the server",
            "pages": "148-153, 159-164"
          }
        },
        {
          "positions": {
            "A1": {
              "left": -0.5,
              "fromNet": 1.5
            },
            "A2": {
              "left": 0,
              "fromNet": 4
            },
            "B1": {
              "left": -0.3,
              "fromNet": 1
            },
            "B2": {
              "left": 0.3,
              "fromNet": 4.4
            }
          },
          "receivedBy": "A1",
          "caption": {
            "en": "After the low serve the server covers net replies; the partner covers returns to the mid- and rearcourt.",
            "vi": "Sau quả giao thấp, người giao lo các cú trả lưới; đồng đội lo các cú trả về giữa và cuối sân."
          },
          "quote": {
            "text": "The server's partner is responsible for covering returns to mid- and rearcourt.",
            "pages": "148-153, 159-164"
          }
        }
      ]
    },
